# ==========================================
# ENVIRONNEMENT GLOBAL CODEQUEST
# ==========================================
NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173

# ==========================================
# BASE DE DONNÉES POSTGRESQL 16
# ==========================================
POSTGRES_USER=codequest
POSTGRES_PASSWORD=codequest_secret
POSTGRES_DB=codequest
DATABASE_URL="postgresql://codequest:codequest_secret@localhost:5432/codequest?schema=public"

# ==========================================
# CACHE & BROKER REDIS
# ==========================================
REDIS_CACHE_URL="redis://localhost:6379"
REDIS_BULLMQ_HOST="127.0.0.1"
REDIS_BULLMQ_PORT=6380

# ==========================================
# SÉCURITÉ & JETONS JWT
# ==========================================
JWT_SECRET=codequest_super_secret_jwt_key_2026_dev
JWT_REFRESH_SECRET=codequest_super_secret_refresh_key_2026_dev
AES_ENCRYPTION_KEY=32_chars_secret_key_for_tests_aes

# ==========================================
# STOCKAGE S3 / MINIO
# ==========================================
MINIO_ROOT_USER=codequest_admin
MINIO_ROOT_PASSWORD=codequest_s3_secret
S3_ENDPOINT=localhost
S3_PORT=9000

# ==========================================
# SERVICES TIERS & INTERNES
# ==========================================
ASSETS_SERVICE_URL=http://localhost:8000
SMTP_HOST=localhost
SMTP_PORT=1025

